# ——— Database (required) ———————————————————————————————————————————————
# Postgres connection string. Local dev:
#   createdb pdsglobal && npx prisma migrate deploy
# Serverless alternatives: Supabase / Neon / Vercel Postgres — paste their
# pooled connection string here.
DATABASE_URL="postgresql://pds:pds@localhost:5432/pdsglobal"

# ——— Brand / contact (optional overrides — defaults live in lib/config.ts) —
# NEXT_PUBLIC_PHONE="+91 88388 20230"
# NEXT_PUBLIC_WHATSAPP="918838820230"
# NEXT_PUBLIC_EMAIL="pdsglobalfinance@gmail.com"
# NEXT_PUBLIC_ADDRESS="No. 13/16 Saurashtra Nagar 1st Street, Choolaimedu, Chennai 600094"
# NEXT_PUBLIC_ENTITY_NAME="PDS Global Financial Services Pvt. Ltd."
# NEXT_PUBLIC_CIN="U65999TN2012PTC087654"

# ——— Lead notifications (enable at least one so leads reach a human) ————
# Where lead emails go (defaults to NEXT_PUBLIC_EMAIL / config.email):
# NOTIFY_EMAIL_TO="pdsglobalfinance@gmail.com"
# NOTIFY_EMAIL_FROM="PDS Global <leads@yourdomain.in>"

# Option A — Resend (https://resend.com):
# RESEND_API_KEY="re_..."

# Option B — any SMTP box (Gmail app password, Zoho, SES SMTP…):
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER="pdsglobalfinance@gmail.com"
# SMTP_PASS="app-password"

# Optional — generic JSON webhook ping per lead (Telegram/WhatsApp bridge,
# Slack incoming webhook, Zapier…). Receives {refCode, subject, summary, text}.
# NOTIFY_WEBHOOK_URL="https://hooks.example.com/..."

# ——— Anti-abuse ————————————————————————————————————————————————————————
# Salt for hashed IP storage (set a long random string in production):
IP_HASH_SALT="change-me-in-production"

# Optional — Upstash Redis REST for cross-instance rate limiting
# (falls back to in-memory per-instance limits when unset):
# UPSTASH_REDIS_REST_URL="https://....upstash.io"
# UPSTASH_REDIS_REST_TOKEN="..."

# Optional — Cloudflare Turnstile (captcha stays off until both are set;
# add the widget with the site key client-side when enabling):
# TURNSTILE_SECRET_KEY="0x..."
# NEXT_PUBLIC_TURNSTILE_SITE_KEY="0x..."
